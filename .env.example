# Copy this file to .env and fill in your own values. Never commit .env.
# See SETUP.md for where to get each value.

# Clerk (auth) - dashboard.clerk.com > your app > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# OpenAI (conversation, code, image) - platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Replicate (music, video) - replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxx

# MySQL database used by Prisma
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Stripe (Pro subscription) - dashboard.stripe.com > Developers
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL of the app (no trailing slash); used for Stripe return links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Crisp support chat (optional) - app.crisp.chat > Settings > Website ID
NEXT_PUBLIC_CRISP_WEBSITE_ID=
